# BobSec Environment Configuration
PORT=4000
NODE_ENV=development
DEMO_MODE=true
AI_PROVIDER=mock

# Optional IBM Watsonx / Granite Configuration (keeps working cleanly in demo mode if empty)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SQLITE_DB_PATH=./bobsec_data.sqlite
